<% content_for :title, "DB 疎通確認" %>

<div style="font-family: sans-serif; max-width: 800px; margin: 40px auto; padding: 20px;">
  <h1>🚀 Rails + RDS 疎通確認</h1>

  <%= current_user.inspect %>
  <% if @db_status[:connected] %>
    <div style="background: #e8f5e8; border: 1px solid #4caf50; border-radius: 8px; padding: 20px; margin: 20px 0;">
      <h2 style="color: #2e7d32; margin-top: 0;">✅ データベース接続成功</h2>
      <table style="border-collapse: collapse; width: 100%;">
        <tr>
          <th style="text-align: left; padding: 8px; border-bottom: 1px solid #ddd;">項目</th>
          <th style="text-align: left; padding: 8px; border-bottom: 1px solid #ddd;">値</th>
        </tr>
        <tr>
          <td style="padding: 8px;">ホスト</td>
          <td style="padding: 8px;"><code><%= @db_status[:host] %></code></td>
        </tr>
        <tr>
          <td style="padding: 8px;">DB サーバー時刻</td>
          <td style="padding: 8px;"><%= @db_status[:current_time] %></td>
        </tr>
        <tr>
          <td style="padding: 8px;">PostgreSQL バージョン</td>
          <td style="padding: 8px;"><code><%= @db_status[:version] %></code></td>
        </tr>
      </table>
    </div>
  <% else %>
    <div style="background: #fff8f8; border: 1px solid #dc3545; border-radius: 8px; padding: 20px; margin: 20px 0;">
      <h2 style="color: #c62828; margin-top: 0;">❌ データベース接続失敗</h2>
      <pre style="background: #f5f5f5; padding: 10px; border-radius: 4px;"><%= @db_status[:error] %></pre>
    </div>
  <% end %>

  <p><small>Powered by Rails + AWS ECS Fargate + RDS PostgreSQL</small></p>
</div>
